generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(auto()) @map("_id") @db.ObjectId
  name                       String
  email                      String    @unique
  password                   String
  role                       Role      @default(user)
  status                     Status    @default(active)
  isVerified                 Boolean   @default(false)
  otp                        String?
  otpExpiry                  DateTime?
  forgetPasswordToken        String?
  forgetPasswordTokenExpires DateTime?
  refreshToken               String?
  refreshTokenExpiresAt      DateTime?
  image                      String?
  phone                      String?
  location                   String?
  fcmToken                   String?
  fcmTokens                  String[]  @default([])
  banners                    Banner[]
  orders                     Order[]
  addresses                  Address[]
  payments                   Payment[]
  templateReviews            TemplateReview[]
  cartItems                  CartItem[]
  wishlistItems              WishlistItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  blogs     Blog[]
  chatbotConversations ChatbotConversation[] @relation("UserChatbotConversations")
  notifications        Notification[]
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  user
  admin
}

model Banner {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String?
  templateCategoryId String? @db.ObjectId

  occasion String
  style    String
  headline String
  slug     String?
  name     String?
  price    Float
  priceInclVat Float?
  priceExclVat Float?
  vatAmount Float?
  vatRate Float?
  areaM2 Float?
  pricePerM2 Float?
  isVatIncluded Boolean?
  material      String?
  eyeletType    String?

  hobbies String[] // MongoDB array field

  description String?

  sizeType  String
  sizeLabel String?
  width     Int
  height    Int

  imageUrl String
  originalImageUrl String?
  variant  Int

  designNumber String?

  revisedPrompt String?

  canvasJSON String?
  source String?
  savedFromEditor Boolean @default(false)
  isSavedDesign Boolean @default(false)
  isOrdered Boolean @default(false)
  designStatus String @default("saved")
  lifecycleStatus String @default("saved")
  orderedAt DateTime?
  orderId String? @db.ObjectId

  metaTitle       String?
  metaDescription String?
  h1Title         String?
  introText       String?
  seoDescription  String?

  isSelected Boolean      @default(false)
  isTemplate Boolean      @default(false)
  isReadymade Boolean     @default(false)
  mockupUrl   String?
  mockupFirstUrl   String?
  mockupHedgeUrl   String?
  mockupPartyUrl   String?
  mockupRailingUrl String?
  mockupLawnNewUrl String?
  mockupGardenUrl  String?
  status     BannerStatus @default(GENERATED)

  generationId String? // group 4 variants

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  templateCategory TemplateCategory? @relation("OldCategoryRelation", fields: [templateCategoryId], references: [id])
  templateCategoryIds String[] @db.ObjectId
  templateCategories TemplateCategory[] @relation("CategoryRelation", fields: [templateCategoryIds], references: [id])
  tuinposterCategoryId String? @db.ObjectId
  tuinposterCategory TuinposterCategory? @relation("OldTuinposterCategoryRelation", fields: [tuinposterCategoryId], references: [id])
  tuinposterCategoryIds String[] @db.ObjectId
  tuinposterCategories TuinposterCategory[] @relation("TuinposterCategoryRelation", fields: [tuinposterCategoryIds], references: [id])
  sku String?
  orders    Order[]
  sourceTemplateId String? @db.ObjectId
  sourceTemplate   Banner? @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateCopies    Banner[] @relation("TemplateCopies")
  templateReviews   TemplateReview[] @relation("TemplateReviews")
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]

  templateSubcategoryId String? @db.ObjectId
  templateSubcategory   TemplateSubcategory? @relation("SubcategoryRelation", fields: [templateSubcategoryId], references: [id])

  svgMaskId   String?  @db.ObjectId
  svgMask     SvgMask? @relation("BannerToSvgMask", fields: [svgMaskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([generationId])
  @@index([designNumber])
  @@index([templateCategoryId])
  @@index([templateSubcategoryId])
  @@index([tuinposterCategoryId])
  @@index([sourceTemplateId])
  @@index([svgMaskId])
  @@index([createdAt])
}

model SvgMask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  svgUrl    String   // URL of the SVG on S3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  banners   Banner[] @relation("BannerToSvgMask")
}


model TemplateCategory {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)
  position Int     @default(0)

  metaTitle       String?
  metaDescription String?
  h1Title         String?
  introText       String?
  seoDescription  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  oldTemplates Banner[] @relation("OldCategoryRelation")
  templateIds String[] @db.ObjectId
  templates Banner[] @relation("CategoryRelation", fields: [templateIds], references: [id])
  subcategories TemplateSubcategory[]
}

model TemplateSubcategory {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String
  isActive           Boolean           @default(true)
  position           Int               @default(0)

  metaTitle          String?
  metaDescription    String?
  h1Title            String?
  introText          String?
  seoDescription     String?

  templateCategoryId String            @db.ObjectId
  templateCategory   TemplateCategory  @relation(fields: [templateCategoryId], references: [id])
  templates          Banner[]          @relation("SubcategoryRelation")
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([templateCategoryId, slug])
}

model TuinposterCategory {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String  @unique
  slug     String  @unique
  isActive Boolean @default(true)
  position Int     @default(0)

  metaTitle       String?
  metaDescription String?
  h1Title         String?
  introText       String?
  seoDescription  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  oldTemplates Banner[] @relation("OldTuinposterCategoryRelation")
  templateIds String[] @db.ObjectId
  templates Banner[] @relation("TuinposterCategoryRelation", fields: [templateIds], references: [id])
}

enum BannerStatus {
  SELECTED
  GENERATED
  ORDERED
}

enum Category {
  wedding
  birthday
  kids_party
  baby_shower
  engagement
}

model Counter {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique
  seq Int
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  quantity Int

  deliveryType   DeliveryType
  deliveryMethod DeliveryMethod
  deliveryLabel  String?
  deliveryTime   String
  estimatedDeliveryDate String?
  deliveryFee    Float          @default(0)

  hasEyelets Boolean @default(false)
  eyeletsFee Float   @default(0)

  subtotal          Float @default(0)
  priceExcludingVat Float @default(0)
  vatRate           Float @default(0.21)
  vatAmount         Float @default(0)
  total             Float

  trackingNumber String? @unique

  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(pending)

  bannerId String? @db.ObjectId
  banner   Banner? @relation(fields: [bannerId], references: [id])
  items    OrderItem[]

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  isGuest             Boolean   @default(false)
  guestEmail          String?
  guestName           String?
  guestPhone          String?
  guestOrderToken     String?
  guestTokenExpiresAt DateTime?

  payment   Payment?
  addresses Address?

  couponId       String?   @db.ObjectId
  coupon         Coupon?   @relation(fields: [couponId], references: [id])
  couponCode     String?
  discountAmount Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoice   Invoice?
  shipments QlsShipment[]
  templateReview TemplateReview?
}

model TemplateReview {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  rating  Int
  comment String?

  templateId String @db.ObjectId
  template   Banner @relation("TemplateReviews", fields: [templateId], references: [id])

  orderId String @unique @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([userId])
}

enum QlsShipmentStatus {
  draft
  created
  printed
  pre_transit
  in_transit
  delivered
  returned
  returned_to_sender
  failed
}

enum QlsShipmentEventType {
  created
  status
  label
  refresh
  webhook
  failed
}

model QlsShipment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  qlsShipmentId        String? @unique
  companyId            String
  brandId              String
  productId            Int?
  productCombinationId Int
  reference            String
  status               QlsShipmentStatus @default(draft)
  weight               Int?
  barcode              String?
  trackingId           String?
  trackingUrl          String?
  labelPdfUrl          String?
  labelZplUrl          String?
  servicepointCode     String?
  lastError            String?
  rawRequest           Json?
  rawResponse          Json?
  lastSyncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    QlsShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([barcode])
  @@index([trackingId])
  @@index([reference])
}

model QlsShipmentEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  shipmentId String?      @db.ObjectId
  shipment   QlsShipment? @relation(fields: [shipmentId], references: [id])

  orderId       String?              @db.ObjectId
  eventType     QlsShipmentEventType
  qlsStatus     String?
  qlsShipmentId String?
  barcode       String?
  trackingId    String?
  payload       Json
  receivedAt    DateTime             @default(now())

  @@index([shipmentId])
  @@index([orderId])
  @@index([qlsShipmentId])
  @@index([barcode])
  @@index([trackingId])
}

model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId   String @unique @db.ObjectId
  userId    String? @db.ObjectId
  paymentId String @db.ObjectId

  invoiceNumber   String  @unique
  invoiceUrl      String
  invoiceFilePath String?

  amount    Float
  vatAmount Float     @default(0)
  status    String    @default("generated")
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
}

enum InvoiceStatus {
  generated
  sent
  failed
}

enum DeliveryType {
  standard_delivery
  express_delivery
  express_pickup
  standard_pickup
}

enum DeliveryMethod {
  delivery
  pickup
}

enum PaymentStatus {
  pending
  paid
  cancelled
  failed
  expired
}

enum OrderStatus {
  pending
  processing
  ready
  shipped
  delivered
  cancelled
  refunded
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  amount        Float
  transactionId String        @unique
  status        PaymentStatus
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  paymentJSON   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model Address {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  email       String
  houseNumber String
  companyName String?
  street      String
  city        String
  zipCode     String
  address     String?
  country     String? @default("NL")
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  orderId     String  @unique
  order       Order   @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decoration {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  image      String
  categoryId String
  category   DecorationCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DecorationCategory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  decorations Decoration[]
}

model Font {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  family    String
  sourceUrl String
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Faq {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  category String
  question String
  answer   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Blog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  content    String
  coverImage String?
  images     String[]
  category   String
  tags       String[]
  isFeatured Boolean  @default(false)

  pdfUrl          String?
  youtubeVideoUrl String?
  youtubeShortUrl String?
  infographicUrl  String?

  metaTitle       String?
  metaDescription String?

  status BlogStatus @default(DRAFT)

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id])

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatbotRole {
  user
  assistant
  developer
}

model ChatbotConversation {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String          @unique
  userId         String?         @db.ObjectId
  title          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User?            @relation("UserChatbotConversations", fields: [userId], references: [id])
  messages ChatbotMessage[]

  @@index([userId])
}

model ChatbotMessage {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  conversationObjectId String             @db.ObjectId
  role                 ChatbotRole
  content              String
  model                String?
  isPartial            Boolean            @default(false)
  createdAt            DateTime           @default(now())

  conversation ChatbotConversation @relation(fields: [conversationObjectId], references: [id])

  @@index([conversationObjectId])
}

model ChatbotSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedBy String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackgroundImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerId   String?  @db.ObjectId
  banner     Banner?  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  partyProductId String? @db.ObjectId
  partyProduct   PartyProduct? @relation(fields: [partyProductId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  hasEyelets Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([bannerId])
  @@index([partyProductId])
}

model OrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bannerId   String?  @db.ObjectId
  banner     Banner?  @relation(fields: [bannerId], references: [id])
  partyProductId String? @db.ObjectId
  partyProduct   PartyProduct? @relation(fields: [partyProductId], references: [id])
  quantity   Int
  hasEyelets Boolean  @default(false)
  eyeletsFee Float    @default(0)
  price      Float
  subtotal   Float
  priceExcludingVat Float
  vatAmount         Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([bannerId])
  @@index([partyProductId])
}

model AlertBarSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  isEnabled Boolean  @default(false)
  message   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingSetting {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  baseBannerPrice      Float    @default(11.95)
  pricePerM2Under1     Float    @default(25.0)
  pricePerM2From1      Float    @default(20.0)
  eyeletsFee           Float    @default(3.5)
  standardPrice60x40   Float    @default(11.95)
  standardPrice120x80  Float    @default(24.00)
  standardPrice180x120 Float    @default(43.20)
  standardPrice240x160 Float    @default(76.80)
  standardDeliveryFee  Float    @default(4.95)
  expressDeliveryFee   Float    @default(14.95)
  standardPickupFee    Float    @default(0.0)
  expressPickupFee     Float    @default(14.95)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String?  @default("info")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
}

model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerId  String   @db.ObjectId
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bannerId])
  @@index([userId])
  @@index([bannerId])
}

model Coupon {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  code              String        @unique
  discountType      DiscountType  @default(percentage)
  discountValue     Float
  minOrderAmount    Float?        @default(0)
  maxDiscountAmount Float?
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?
  usedCount         Int           @default(0)
  isActive          Boolean       @default(true)
  description       String?

  orders            Order[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([isActive])
}

enum DiscountType {
  percentage
  fixed
}

model DesignRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String?
  dimensions   String
  eyelets      String
  requirements String
  fileUrls     String[] @default([])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PartyCategory {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String         @unique
  slug            String         @unique
  description     String?
  age             Int?           // Optional specific age milestone, e.g. 50
  isMilestone     Boolean        @default(false)
  metaTitle       String?
  metaDescription String?
  h1Title         String?
  introText       String?
  seoDescription  String?
  isActive        Boolean        @default(true)
  position        Int            @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  products        PartyProduct[]
}

model PartyProduct {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String         @unique
  description     String?
  price           Float
  priceInclVat    Float?
  priceExclVat    Float?
  vatRate         Float?         @default(0.21)
  sku             String?
  images          String[]       @default([]) // Multiple images supported
  featuredImage   String?
  inStock         Boolean        @default(true)
  stockQuantity   Int?           @default(100)
  ages            Int[]          @default([]) // Target birthday milestone ages, e.g. [50]
  tags            String[]       @default([])
  isUpsellOnly    Boolean        @default(false)
  isActive        Boolean        @default(true)

  metaTitle       String?
  metaDescription String?
  seoDescription  String?

  categoryId      String?        @db.ObjectId
  category        PartyCategory? @relation(fields: [categoryId], references: [id])

  cartItems       CartItem[]
  orderItems      OrderItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
}
